#!/bin/sh
set -eu
lb config noauto \
  --mode debian --distribution trixie --architecture amd64 \
  --binary-image iso-hybrid --bootloaders "syslinux grub-efi" \
  --uefi-secure-boot disable --debian-installer none \
  --archive-areas main --firmware-chroot false --firmware-binary false \
  --mirror-bootstrap https://deb.debian.org/debian \
  --mirror-chroot https://deb.debian.org/debian \
  --mirror-binary https://deb.debian.org/debian \
  --mirror-chroot-security https://security.debian.org/debian-security \
  --mirror-binary-security https://security.debian.org/debian-security \
  --security true --updates true --apt-recommends true \
  --apt-source-archives true --apt-indices true \
  --linux-flavours amd64 --image-name motaos-0.1-trixie \
  --iso-application MotaOS --iso-volume MOTAOS_0_1 \
  --iso-publisher MotaOS --checksums sha256 \
  --bootappend-live "boot=live components username=mota hostname=motaos locales=pt_BR.UTF-8 keyboard-layouts=br keyboard-model=abnt2 timezone=America/Sao_Paulo" \
  "$@"
