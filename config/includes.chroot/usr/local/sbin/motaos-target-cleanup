#!/bin/bash
set -Eeuo pipefail
# Executed only inside the installed target by Calamares.
[[ $EUID == 0 ]] || exit 1
[[ ! -e /run/live/medium/live/filesystem.squashfs ]] || { echo 'Recusando limpar a sessão live.'; exit 1; }
# The live user is created at boot, outside the squashfs copied by unpackfs.
# Remove only known live privilege/autologin snippets, never the new user's home.
rm -f /etc/sudoers.d/live /etc/sudoers.d/live-config
if [[ -d /etc/lightdm/lightdm.conf.d ]]; then
  find /etc/lightdm/lightdm.conf.d -maxdepth 1 -type f -name '*live*' -delete
fi
rm -f /usr/share/applications/motaos-install.desktop
rm -f /etc/xdg/autostart/calamares-desktop-icon.desktop
rm -f /etc/skel/Desktop/calamares-install-debian.desktop
rm -f /etc/apt/sources.list.d/motaos.sources
cat > /etc/apt/sources.list <<'SOURCES'
deb https://deb.debian.org/debian trixie main
deb-src https://deb.debian.org/debian trixie main
deb https://deb.debian.org/debian trixie-updates main
deb-src https://deb.debian.org/debian trixie-updates main
deb https://security.debian.org/debian-security trixie-security main
deb-src https://security.debian.org/debian-security trixie-security main
SOURCES
